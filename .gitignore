# Secrets - never commit
.env
frontend/.env
frontend/.env.local
frontend/.env.*.local
*.pem
.env
.env.*
!.env.example
# Node / Vite build
node_modules/
dist/
.vite/
npm-debug.log*

# Vercel
.vercel/

# Cloudflare / Wrangler (the deploy command's own scratch directory)
.wrangler/

# Virtual environments
.venv/
.venv-agent/
venv/
env/

# Local Agent build output (build-agent.bat). The packaged agent is a build
# artifact, not source: reproduce it with build-agent.bat rather than committing
# a binary.
SeedMailAgent/
build/agent/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Logs
logs/
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temp files created by the atomic writer
.*.tmp
*.corrupt
start.bat.vercel
.env*
# The desktop application's source is tracked; its build outputs are excluded by
# desktop/.gitignore (node_modules/, release/, generated/). The previous rule
# ignored the whole desktop/ directory, which silently dropped new source files
# — including the offline page the shell loads when the deployed site cannot be
# reached.
