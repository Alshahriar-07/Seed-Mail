# Seed Code Mail — send worker / backend configuration
#
# Placeholders only: copy to `.env` and fill in real values. `.env` is
# git-ignored and is never deployed to the browser or to Vercel.
#
# This file configures TWO different things:
#   * the Gmail SMTP campaign sender (worker/main.py) — Gmail / SMTP_* below;
#   * the Supabase project the worker verifies users against and reads the
#     campaign queue from — SUPABASE_* below.
#
# IMPORTANT — this is NOT the frontend configuration. The browser build reads
# `frontend/.env` (`VITE_SUPABASE_URL`, `VITE_SUPABASE_PUBLISHABLE_KEY`). Vite
# inlines those values into the public bundle, so they are public and are
# deliberately NOT read here. A value with a VITE_ prefix will be ignored by
# the worker, which is the single most common cause of the worker reporting
# "cannot verify signed-in users".

# --- Gmail SMTP (campaign sending) -----------------------------------------
# Email      = sender Gmail address
# GAPP_PASS  = Gmail App Password (16 chars, requires 2-Step Verification).
#              NOTE: an App Password is only valid for SMTP/IMAP. It does NOT
#              grant Gmail API access — the API uses OAuth 2.0 (see the Google
#              section below and README → Gmail account connection).
# SENDER_NAME= display name used in the From header and {{SENDER_NAME}}
# GITHUB_URL = optional GitHub profile/project URL used by {{GITHUB_URL}}
#
# There is no default email subject. The subject is set per campaign.
Email=
GAPP_PASS=
SENDER_NAME=Al Shahriar Sowan
GITHUB_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SEND_DELAY_SECONDS=5
SMTP_TIMEOUT_SECONDS=30
MAX_RETRIES=2
RETRY_DELAY_SECONDS=10

# --- Supabase (REQUIRED for the worker to authenticate users) --------------
# Both are REQUIRED. Without them every authenticated worker request fails with
# HTTP 401 ("cannot verify signed-in users"). SUPABASE_ANON_KEY is accepted as
# an alias for the publishable key.
#
# SUPABASE_PUBLISHABLE_KEY is the PUBLIC publishable (anon) key — it is only
# used to verify the bearer token a signed-in user presents. It is not a secret.
SUPABASE_URL=https://jptukeybgvuehdzghxfj.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Service-role key: ONLY for the trusted worker host, and only needed for
# campaign delivery (claiming queued campaigns + writing progress). Reading and
# sending ordinary mail in the app does not use it. Never put it in
# frontend/.env, never add a VITE_ prefix, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth 2.0 (Gmail API) ------------------------------------------
# Used by the Vercel backend under `api/gmail/` for Inbox / Compose / Sent.
# These belong in the Vercel project's environment variables, not here, unless
# you also want this worker to report Gmail API readiness.
#
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#       From Google Cloud Console → APIs & Services → Credentials
#       (OAuth client type: Web application).
#   GOOGLE_OAUTH_REDIRECT_URI
#       Must exactly match an "Authorised redirect URI" on that OAuth client,
#       e.g. https://mrseedmail.vercel.app/api/gmail/callback
#   GMAIL_TOKEN_ENCRYPTION_KEY
#       Encrypts stored Gmail refresh tokens (AES-256-GCM). A random 32-byte
#       value; generate with:  openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GMAIL_TOKEN_ENCRYPTION_KEY=

# --- Worker HTTP server ----------------------------------------------------
# 127.0.0.1 = this machine only (local development). A hosted deployment sets
# WORKER_HOST=0.0.0.0 so the browser can reach it.
WORKER_HOST=127.0.0.1
WORKER_PORT=8765

# Durable queue consumer (runs in the same process as the API by default)
WORKER_QUEUE_CONSUMER=1
WORKER_ID=
WORKER_LEASE_SECONDS=300
WORKER_POLL_SECONDS=5

# Origins allowed to call the worker (comma separated). The beta origin is kept
# for testing: https://seedmail-beta.vercel.app
WORKER_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://127.0.0.1:8000,https://mrseedmail.vercel.app,https://seedmail-beta.vercel.app
