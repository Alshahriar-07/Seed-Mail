# Seed Code Mail — frontend (Vite) environment
#
# Copy to `frontend/.env` for local development and set the same variables in
# the Vercel project (Settings → Environment Variables) for Production,
# Preview and Development. Only variables prefixed with VITE_ reach the
# browser bundle, and everything here is PUBLIC by design:
#
#   * the Supabase project URL and publishable (anon) key are meant to be
#     shipped to clients — access control is enforced by Row Level Security.
#
# NEVER put a Supabase secret/service-role key, a Gmail App Password, or any
# other secret in this file or behind a VITE_ name — Vite inlines those values
# into the public JavaScript bundle.

# Supabase project (Data API + Auth)
VITE_SUPABASE_URL=https://jptukeybgvuehdzghxfj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL of the local Gmail SMTP send worker (see worker/README section in the
# root README). Emails are sent by this worker, never by the browser and never
# by Vercel serverless functions. Leave as-is for local use.
VITE_MAIL_WORKER_URL=http://127.0.0.1:8765

# Public site origin used for canonical URLs / structured data.
# Production is served over HTTPS only: http:// requests to this host are
# answered with a 308 redirect to https://.
VITE_SITE_URL=https://mrseedmail.vercel.app
